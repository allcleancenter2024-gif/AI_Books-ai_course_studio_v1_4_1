{
  "name": "ai-course-studio-publisher",
  "version": "1.25.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3010",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3010",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "check:content": "node scripts/check-content.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check": "npm run test && npm run check:content && npm run check:links && npm run lint && npm run build"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3"
  }
}
