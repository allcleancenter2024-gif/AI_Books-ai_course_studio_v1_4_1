generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ServiceRecord {
  id          Int
  entityType  String
  payload     Json
  mongoId     String?
  createdAt   DateTime?
  updatedAt   DateTime  @default(now())
  @@id([id, entityType])
  @@index([entityType, updatedAt])
  @@index([mongoId])
}
