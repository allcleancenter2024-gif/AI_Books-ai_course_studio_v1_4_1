# Copy this file to .env and replace only the values marked CHANGE_ME.
# SQLite remains the authoritative Studio store. Docker PostgreSQL/MongoDB are
# optional replication/integration services and are never auto-promoted.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8765
PUBLIC_ACCESS=false
PUBLIC_BASE_URL=
AI_COURSE_STUDIO_RUNTIME_DIR=
MAX_UPLOAD_SIZE_MB=500
UPLOAD_CHUNK_SIZE_MB=1
# Parsing and indexing run after the HTTP upload returns. Keep this conservative
# on desktop hosts; each accepted job has durable SQLite status.
AI_COURSE_STUDIO_UPLOAD_PARSE_MAX_CONCURRENT=1
AI_COURSE_STUDIO_UPLOAD_PARSE_QUEUE_LIMIT=2
AI_COURSE_STUDIO_UPLOAD_STAGING_RETENTION_SECONDS=86400
AI_COURSE_STUDIO_COOKIE_SECURE=0

# Local AI providers are server-side only. Keep their hosts loopback unless a
# separately reviewed private-network deployment explicitly requires otherwise.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_TIMEOUT_SECONDS=900
LMSTUDIO_ENABLED=true
LMSTUDIO_BASE_URL=http://127.0.0.1:12345/v1
LMSTUDIO_TIMEOUT_SECONDS=180
# LM Studio requests are deliberately serialized; concurrency is fixed at 1.
DEFAULT_AI_PROVIDER=auto
WEB_SEARCH_ENABLED=true

POSTGRES_DB=ai_course_studio
POSTGRES_USER=ai_course_app
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
MONGO_INITDB_DATABASE=ai_course_raw
MONGO_INITDB_ROOT_USERNAME=ai_course_admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
PGADMIN_DEFAULT_EMAIL=admin@ai-course-studio.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# Host access for local tools. These deliberately avoid ports used by other projects.
POSTGRES_HOST_PORT=5434
MONGO_HOST_PORT=27018
PGADMIN_HOST_PORT=5051
MONGO_EXPRESS_HOST_PORT=8082
APP_API_HOST_PORT=3001

# Adaptive web RAG. SearXNG remains localhost-only and is optional at runtime.
AI_COURSE_STUDIO_WEB_SEARCH_PROVIDER=searxng
SEARXNG_ENABLED=true
SEARXNG_BASE_URL=http://127.0.0.1:8888
SEARXNG_HOST_PORT=8888
SEARXNG_TIMEOUT_SECONDS=15
SEARXNG_CACHE_MAX_ENTRIES=256
SEARXNG_MAX_RESULTS=8
SEARXNG_CACHE_TTL_SECONDS=86400

# Optional Firecrawl Cloud. Keep disabled until a server-only key is entered.
FIRECRAWL_API_KEY=
FIRECRAWL_ENABLED=false
FIRECRAWL_MAX_RESULTS=5
FIRECRAWL_MONTHLY_BUDGET_ENABLED=true
FIRECRAWL_MONTHLY_REQUEST_LIMIT=100
FIRECRAWL_TIMEOUT_SECONDS=30
FIRECRAWL_MAX_RETRIES=1

# Local extraction fallback. Uploaded documents are never sent to these services.
LOCAL_WEB_EXTRACTOR_ENABLED=true
LOCAL_WEB_EXTRACTOR_MAX_BYTES=8388608
LOCAL_WEB_EXTRACTOR_MAX_TEXT_CHARS=120000
LOCAL_WEB_EXTRACTOR_TIMEOUT_SECONDS=15
LOCAL_WEB_EXTRACTOR_RESPECT_ROBOTS=true

# Optional GitHub source backup. Keep the token in this server-only .env file.
GITHUB_REPOSITORY=OWNER/REPOSITORY
GITHUB_REPOSITORY_URL=https://github.com/OWNER/REPOSITORY
GITHUB_TOKEN=
# OpenAI external editing is disabled unless explicitly enabled. Keep the key server-side.
AI_COURSE_STUDIO_EXTERNAL_EDIT_ENABLED=0
OPENAI_API_KEY=CHANGE_ME
OPENAI_EXTERNAL_EDIT_MODEL=gpt-4o-mini
OPENAI_INPUT_USD_PER_1K=CHANGE_ME
OPENAI_OUTPUT_USD_PER_1K=CHANGE_ME
